{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "escr:magical_teleporter/teleport",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "minecraft:textures/particle/generic_6.png"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 200,
        "max_particles": 500
      },
      "minecraft:emitter_lifetime_looping": {
        "active_time": 1
      },
      "minecraft:emitter_shape_custom": {
        "offset": [
          "variable.particle_random_1 < 3.0/17.0 ? -2.5 : (variable.particle_random_1 < 6.0/17.0 ? 2.5 : -2.5 + 5.0 * variable.particle_random_3)",
          "variable.particle_random_1 < 12.0/17.0 ? 3.0 * variable.particle_random_2 : 3.0",
          "variable.particle_random_1 < 6.0/17.0 ? -2.5 + 5.0 * variable.particle_random_3 : (variable.particle_random_1 < 9.0/17.0 ? -2.5 : (variable.particle_random_1 < 12.0/17.0 ? 2.5 : -2.5 + 5.0 * variable.particle_random_3))"
        ],
        "direction": [0, 1, 0]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": [0.5, 0.5],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 64,
          "flipbook": {
            "base_UV": [0, 0],
            "size_UV": [16, 16],
            "step_UV": [0, 16],
            "frames_per_second": 15,
            "max_frame": 4,
            "loop": true
          }
        }
      }
    }
  }
}
